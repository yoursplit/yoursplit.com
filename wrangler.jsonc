{
	"name": "yoursplit",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-04",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	}
}
